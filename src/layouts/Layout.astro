---
// Layout global du portfolio (dérivé du Layout Nova).
// Rend la navigation, le pied de page (avec le bloc contact), les métadonnées SEO,
// le mode clair/sombre et les scripts d'animation du template.
import '@styles/global.css';
// Jeu complet d'icônes Phosphor en dev ; le build supprime les règles inutilisées.
import '@styles/.generated/phosphor.css';
import { ClientRouter } from 'astro:transitions';
import Schema from '@components/ui/atoms/Schema.astro';
import Toast from '@components/ui/atoms/Toast.astro';
import ImageLightbox from '@/components/ui/molecules/ImageLightbox.astro';
import MobileDrawer from '@components/ui/molecules/Navbar/shared/MobileDrawer.astro';
import Navbar from '@components/ui/molecules/Navbar.astro';
import NovaFooterBlock from '@components/registry/shell/NovaFooterBlock.astro';
import { getNovaCopy, translatePath, type NovaLocale } from '@utils/nova-i18n';
import { SITE_URL } from '../../site.config.mjs';

interface Props {
	title?: string;
	description?: string;
	/** Image Open Graph (chemin dans public/). */
	ogImage?: string;
	ogType?: 'website' | 'article' | 'profile';
	noIndex?: boolean;
	locale?: NovaLocale;
	/** true quand la page commence par un hero plein cadre sous la barre flottante. */
	fullBleedTop?: boolean;
}

const {
	locale = 'fr',
	title: titleProp,
	description: descriptionProp,
	ogImage = locale === 'en' ? '/og-image-en.png' : '/og-image.png',
	ogType = 'website',
	noIndex = false,
	fullBleedTop = false,
} = Astro.props;

const copy = getNovaCopy(locale);
const title = titleProp ?? copy.page.title;
const description = descriptionProp ?? copy.page.description;

const siteOrigin = new URL(SITE_URL).origin;
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, siteOrigin).href;
const alternateFr = new URL(translatePath(pathname, 'fr'), siteOrigin).href;
const alternateEn = new URL(translatePath(pathname, 'en'), siteOrigin).href;
const ogImageAbsolute = new URL(ogImage, siteOrigin).href;
const robotsContent = noIndex ? 'noindex, follow' : 'index, follow';

const lightboxLabels = locale === 'en'
	? { closeLabel: 'Close preview', lightboxAlt: 'Enlarged image', prevLabel: 'Previous image', nextLabel: 'Next image' }
	: { closeLabel: "Fermer l'aperçu", lightboxAlt: 'Image agrandie', prevLabel: 'Image précédente', nextLabel: 'Image suivante' };

// La barre flottante se superpose au hero ; sans hero, on compense sa hauteur.
const mainPaddingStyle = fullBleedTop
	? 'padding-top: 0'
	: 'padding-top: calc(var(--site-header-height, 5.75rem) + var(--hero-below-header-gap, 0.75rem))';
---

<!DOCTYPE html>
<html lang={locale} data-theme="nova" data-lenis="true">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Mode clair/sombre appliqué avant le premier rendu (pas de flash). -->
		<script is:inline>
			(function () {
				var mode = null;
				try { mode = localStorage.getItem('pf-mode'); } catch (e) {}
				if (mode !== 'light' && mode !== 'dark') {
					mode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.setAttribute('data-mode', mode);
			})();
		</script>
		<link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-400.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-500.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi-700.woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0b1220" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			if (document.documentElement.hasAttribute('data-motion-disabled')) {
				document.documentElement.removeAttribute('data-motion-ready');
			} else {
				document.documentElement.setAttribute('data-motion-ready', '');
				// Si motion.js ne se charge pas, le contenu ne doit pas rester invisible.
				setTimeout(function () {
					if (!window.__webscaleFadeMotion) document.documentElement.removeAttribute('data-motion-ready');
				}, 3000);
			}
		</script>
		<ClientRouter />
		<Schema locale={locale} description={description} />
		<meta http-equiv="Content-Security-Policy" content="
			default-src 'self';
			script-src 'self' 'unsafe-inline';
			style-src 'self' 'unsafe-inline';
			font-src 'self' data:;
			img-src 'self' data: blob:;
			connect-src 'self' https://api.web3forms.com;
			frame-src 'self' https://open.spotify.com;
			form-action 'self' https://api.web3forms.com mailto:;
			base-uri 'self';
		" />
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<meta name="author" content="Yassir Drissi" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="fr" href={alternateFr} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="x-default" href={alternateFr} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Yassir Drissi" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'fr_FR'} />
		<meta property="og:locale:alternate" content={locale === 'en' ? 'fr_FR' : 'en_US'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbsolute} />
	</head>
	<body class="min-h-screen flex flex-col ui-bg-page font-sans text-brand-dark antialiased selection:bg-brand-accent/20 selection:text-brand-dark">
		<a href="#contenu" class="pf-skip-link">{copy.navigation.skipLink}</a>
		<MobileDrawer locale={locale} />
		<div class="relative">
			<Navbar layout="floating" theme="light" locale={locale} />
		</div>
		<main id="contenu" class="flex-1 flex flex-col" style={mainPaddingStyle} tabindex="-1">
			<slot />
		</main>
		<NovaFooterBlock locale={locale} />

		<script is:inline data-astro-rerun src="/js/motion.js" defer></script>
		<script is:inline>
			document.addEventListener('astro:before-swap', function (event) {
				document.documentElement.style.scrollBehavior = 'auto';
				// Conserve le mode clair/sombre lors des transitions de page.
				var mode = document.documentElement.getAttribute('data-mode');
				if (mode && event.newDocument) event.newDocument.documentElement.setAttribute('data-mode', mode);
			});
			document.addEventListener('astro:page-load', function () {
				document.documentElement.style.scrollBehavior = '';
			});
			if (!window.__pfThemeToggle) {
				window.__pfThemeToggle = true;
				document.addEventListener('click', function (event) {
					var button = event.target && event.target.closest ? event.target.closest('[data-theme-toggle]') : null;
					if (!button) return;
					var next = document.documentElement.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
					document.documentElement.setAttribute('data-mode', next);
					try { localStorage.setItem('pf-mode', next); } catch (e) {}
				});
			}
		</script>
		<script is:inline data-astro-rerun src="/js/navbar.js" defer></script>
		<script is:inline data-astro-rerun src="/js/accordion.js" defer></script>
		<script is:inline src="/js/lenis-lib.min.js" defer></script>
		<script is:inline src="/js/lenis.js" defer></script>
		<Toast />
		<ImageLightbox {...lightboxLabels} />
	</body>
</html>
