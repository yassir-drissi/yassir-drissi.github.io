---
// Pied de page Nova transformé en bloc contact : appel au PFE, liens directs,
// formulaire Web3Forms (sans backend) et crédits du modèle (exigés par la licence).
import Text from "@components/ui/atoms/Text.astro";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";
import { profile } from "@data/portfolio/profile";

interface Props {
  locale?: NovaLocale;
}

const { locale = "fr" } = Astro.props as Props;
const ui = getNovaCopy(locale);
const copy = ui.contact;
const footer = ui.footer;
const footerLinks = ui.navigation.menu.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));
const legalLinks = footer.legalLinks.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));
const hasForm = profile.web3formsAccessKey.trim().length > 0;
const year = new Date().getFullYear();

const directLinks = [
  { href: `mailto:${profile.email}`, icon: "envelope-simple", label: profile.email, external: false },
  { href: profile.links.linkedin, icon: "linkedin-logo", label: "LinkedIn", external: true },
  { href: profile.links.github, icon: "github-logo", label: "GitHub", external: true },
  { href: profile.links.spotify, icon: "spotify-logo", label: "EngiTalks · Spotify", external: true },
  { href: profile.cv[locale], icon: "file-arrow-down", label: ui.hero.downloadCv, external: false, download: true },
];
---

<footer id="contact" class="pf-contact relative overflow-hidden rounded-t-[var(--rounded-lg)]">
  <div class="pf-contact__glow" aria-hidden="true"></div>
  <div class="ui-container relative z-10 mx-auto grid w-[min(100%-2rem,80rem)] gap-12 py-16 pb-8 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-16">
      <div>
        <p class="mb-5 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.14em] text-[var(--pf-ink-accent)]">
          <span class="pf-pulse" aria-hidden="true"></span>
          <span>{copy.eyebrow}</span>
        </p>
        <h2 class="m-0 text-[clamp(2.1rem,5vw,3.75rem)] font-bold leading-[1] tracking-[-0.05em] text-[var(--pf-ink-text)]">{copy.heading}</h2>
        <p class="mt-6 max-w-xl text-[clamp(1rem,1.4vw,1.15rem)] leading-[1.6] text-[var(--pf-ink-muted)]">{copy.description}</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2" role="list">
          {directLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="pf-contact__link"
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                download={link.download ? "" : undefined}
              >
                <i class={`ph ph-${link.icon} text-xl`} aria-hidden="true"></i>
                <span class="min-w-0 truncate">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="pf-contact__card">
        <h3 class="m-0 text-lg font-semibold text-[var(--pf-ink-text)]">{copy.form.title}</h3>
        {hasForm ? (
          <form class="mt-5 grid gap-4" action="https://api.web3forms.com/submit" method="POST" data-pf-contact-form>
            <input type="hidden" name="access_key" value={profile.web3formsAccessKey} />
            <input type="hidden" name="subject" value={copy.form.subject} />
            <input type="hidden" name="from_name" value="Portfolio Yassir Drissi" />
            <!-- Pot de miel anti-spam : invisible pour un humain, rempli par les robots. Web3Forms rejette l'envoi si la case est cochée. -->
            <label class="pf-honeypot" aria-hidden="true">
              Ne pas cocher
              <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
            </label>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="pf-field">
                <span>{copy.form.name}</span>
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label class="pf-field">
                <span>{copy.form.emailField}</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
            </div>
            <label class="pf-field">
              <span>{copy.form.company}</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
            <label class="pf-field">
              <span>{copy.form.message}</span>
              <textarea name="message" rows="4" required></textarea>
            </label>
            <button type="submit" class="ui-button ui-button-accent min-h-11 w-full justify-center rounded-full px-6 py-3 font-semibold sm:w-fit" data-label={copy.form.submit} data-sending={copy.form.sending}>
              {copy.form.submit}
            </button>
            <p class="m-0 min-h-6 text-sm" role="status" aria-live="polite" data-pf-form-status data-success={copy.form.success} data-error={copy.form.error} data-offline={copy.form.offline}></p>
          </form>
        ) : (
          <p class="mt-4 text-[var(--pf-ink-muted)]">
            {copy.form.fallback}{" "}
            <a href={`mailto:${profile.email}`} class="font-semibold text-[var(--pf-ink-accent)] underline underline-offset-4">{profile.email}</a>
          </p>
        )}
      </div>
    </div>

    <div class="flex flex-col items-center gap-6 border-t border-[var(--pf-ink-border)] pt-8 text-center sm:flex-row sm:justify-between sm:text-left">
      <nav aria-label={footer.ariaNavigation} class="flex flex-wrap justify-center gap-x-6 gap-y-2 sm:justify-start">
        {footerLinks.map((link) => <a href={link.href} class="pf-footer-link">{link.label}</a>)}
      </nav>
      <nav aria-label={footer.ariaLegal} class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        {legalLinks.map((link) => <a href={link.href} class="pf-footer-link">{link.label}</a>)}
      </nav>
    </div>
    <div class="-mt-6 flex flex-col items-center gap-2 text-center text-[var(--pf-ink-muted)] sm:flex-row sm:justify-between sm:text-left">
      <Text tag="span" variant="feature-body-sm" class="!text-inherit">© {year} {profile.name}. {footer.copyright}</Text>
      <Text tag="span" variant="feature-body-sm" class="!text-inherit">
        {footer.attributionPrefix}<a href={footer.attributionLinkHref} target="_blank" rel="noopener noreferrer" class="pf-footer-link">{footer.attributionLinkLabel}</a>, {footer.distributedBy} <a href="https://themewagon.com" target="_blank" rel="noopener noreferrer" class="pf-footer-link">ThemeWagon</a>
      </Text>
    </div>
  </div>
</footer>

<script is:inline data-astro-rerun>
  (function () {
    var form = document.querySelector('[data-pf-contact-form]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    var status = form.querySelector('[data-pf-form-status]');
    var button = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      status.classList.remove('is-success', 'is-error');
      var trap = form.querySelector('input[name="botcheck"]');
      if (trap && trap.checked) {
        // Robot détecté : on n'envoie rien et on ne lui signale pas l'échec.
        status.textContent = status.dataset.success;
        form.reset();
        return;
      }
      if (!navigator.onLine) {
        status.textContent = status.dataset.offline;
        status.classList.add('is-error');
        return;
      }
      button.disabled = true;
      button.textContent = button.dataset.sending;
      status.textContent = '';
      fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) })
        .then(function (response) {
          return response.json().catch(function () { return { success: false }; }).then(function (data) {
            if (!response.ok || !data.success) throw new Error((data && data.message) || String(response.status));
          });
        })
        .then(function () {
          status.textContent = status.dataset.success;
          status.classList.add('is-success');
          form.reset();
        })
        .catch(function () {
          status.textContent = status.dataset.error;
          status.classList.add('is-error');
        })
        .finally(function () {
          button.disabled = false;
          button.textContent = button.dataset.label;
        });
    });
  })();
</script>

<style>
  .pf-contact {
    background: var(--pf-ink);
    color: var(--pf-ink-text);
  }

  .pf-contact__glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: min(60rem, 120%);
    height: 40rem;
    background: radial-gradient(closest-side, rgb(37 99 235 / 0.35), transparent 70%);
    pointer-events: none;
  }

  .pf-pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgb(34 197 94 / 0.6);
    animation: pf-pulse 2.2s ease-out infinite;
  }

  @keyframes pf-pulse {
    to { box-shadow: 0 0 0 0.6rem rgb(34 197 94 / 0); }
  }

  .pf-contact__link {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--pf-ink-border);
    border-radius: var(--ui-radius-md);
    padding: 0.75rem 1rem;
    color: var(--pf-ink-text);
    font-weight: 500;
    text-decoration: none;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .pf-contact__link:hover {
    border-color: var(--pf-ink-accent);
    background: rgb(96 165 250 / 0.08);
  }

  .pf-contact__link i {
    color: var(--pf-ink-accent);
  }

  .pf-contact__card {
    border: 1px solid var(--pf-ink-border);
    border-radius: var(--ui-radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: rgb(255 255 255 / 0.03);
  }

  .pf-field {
    display: grid;
    gap: 0.4rem;
    color: var(--pf-ink-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .pf-field input,
  .pf-field textarea {
    width: 100%;
    border: 1px solid var(--pf-ink-border);
    border-radius: var(--ui-radius-sm);
    padding: 0.7rem 0.85rem;
    background: rgb(255 255 255 / 0.04);
    color: var(--pf-ink-text);
    font: inherit;
    font-size: 1rem;
  }

  .pf-field input:focus,
  .pf-field textarea:focus {
    border-color: var(--pf-ink-accent);
    outline: none;
    box-shadow: 0 0 0 3px rgb(96 165 250 / 0.25);
  }

  .pf-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  [data-pf-form-status].is-success { color: #4ade80; }
  [data-pf-form-status].is-error { color: #fca5a5; }

  .pf-footer-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--pf-ink-text);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .pf-footer-link:hover {
    color: var(--pf-ink-accent);
  }

  @media (min-width: 640px) {
    .pf-footer-link {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-pulse { animation: none; }
  }
</style>
