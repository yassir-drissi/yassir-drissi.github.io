---
// Grille de projets avec filtres par domaine (fonctionne sans JS : tout est affiché).
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import ProjectCard from './ProjectCard.astro';
import { projects, projectFilters } from '@data/portfolio/projects';
import { getNovaCopy, type NovaLocale } from '@utils/nova-i18n';

interface Props {
  locale: NovaLocale;
}

const { locale } = Astro.props;
const ui = getNovaCopy(locale).projects;
const counts = Object.fromEntries(
  projectFilters.map((f) => [f.id, f.id === 'all' ? projects.length : projects.filter((p) => p.category === f.id).length]),
);
---

<Section id="projets" tone="page" class="py-[clamp(4rem,7vw,6.5rem)]">
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-motion-sequence="viewport" data-motion-profile="soft">
      <div>
        <Heading tag="h2" variant="section-title">{ui.title}</Heading>
        <Text variant="lead" class="mt-3 max-w-xl">{ui.description}</Text>
      </div>
      <p class="m-0 text-sm ui-text-on-light-subtle" aria-live="polite" data-pf-count data-template-one={ui.count(1)} data-template-many={ui.count(2)}>{ui.count(projects.length)}</p>
    </div>

    <div class="pf-filters" role="group" aria-label={ui.filtersLabel} data-pf-filters>
      {projectFilters.map((filter, index) => (
        <button
          type="button"
          class="pf-filter"
          data-filter={filter.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {filter.label[locale]}
          <span class="pf-filter__count">{counts[filter.id]}</span>
        </button>
      ))}
    </div>

    <div class="pf-grid" data-pf-grid>
      {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </Container>
</Section>

<script is:inline data-astro-rerun>
  (function () {
    var group = document.querySelector('[data-pf-filters]');
    var grid = document.querySelector('[data-pf-grid]');
    if (!group || !grid || group.dataset.ready) return;
    group.dataset.ready = 'true';
    var count = document.querySelector('[data-pf-count]');
    group.addEventListener('click', function (event) {
      var button = event.target.closest('[data-filter]');
      if (!button) return;
      var filter = button.getAttribute('data-filter');
      group.querySelectorAll('[data-filter]').forEach(function (b) {
        b.setAttribute('aria-pressed', b === button ? 'true' : 'false');
      });
      var visible = 0;
      grid.querySelectorAll('[data-category]').forEach(function (card) {
        var show = filter === 'all' || card.getAttribute('data-category') === filter;
        card.hidden = !show;
        if (show) visible++;
      });
      if (count) {
        var template = visible > 1 ? count.dataset.templateMany : count.dataset.templateOne;
        count.textContent = template.replace(/\d+/, String(visible));
      }
    });
  })();
</script>

<style>
  .pf-filters {
    display: flex;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-bottom: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pf-filters::-webkit-scrollbar {
    display: none;
  }

  .pf-filter {
    display: inline-flex;
    min-height: 2.75rem;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    color: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .pf-filter:hover {
    border-color: var(--color-brand-accent);
  }

  .pf-filter[aria-pressed='true'] {
    border-color: var(--color-brand-accent);
    background: var(--color-brand-accent);
    color: var(--pf-on-accent);
  }

  .pf-filter__count {
    border-radius: 9999px;
    padding: 0 0.4rem;
    background: color-mix(in oklab, currentColor 14%, transparent);
    font-size: 0.75rem;
  }

  .pf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .pf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    .pf-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
