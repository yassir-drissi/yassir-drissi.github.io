---
// Page détail d'un projet : Problème → Données → Approche → Résultats → Ce que j'améliorerais.
import Layout from '@layouts/Layout.astro';
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import T from './T.astro';
import { projects, getProject, categoryLabels } from '@data/portfolio/projects';
import { getNovaCopy, getNovaLocalePath, localizePath, type NovaLocale } from '@utils/nova-i18n';
import { resolveProjectImage } from '@utils/portfolio-images';

interface Props {
  slug: string;
  locale: NovaLocale;
}

const { slug, locale } = Astro.props;
const project = getProject(slug)!;
const ui = getNovaCopy(locale);
const t = ui.projectPage;
const index = projects.findIndex((p) => p.slug === slug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const images = (
  await Promise.all(
    (project.images ?? []).map(async (image) => {
      const resolved = await resolveProjectImage(image);
      return resolved ? { ...image, ...resolved } : null;
    }),
  )
).filter((image) => image !== null);

const sections = [
  { id: 'donnees', title: t.data, items: project.details.data[locale], icon: 'database' },
  { id: 'approche', title: t.approach, items: project.details.approach[locale], icon: 'path' },
  { id: 'resultats', title: t.results, items: project.details.results[locale], icon: 'chart-bar' },
  { id: 'ameliorations', title: t.improve, items: project.details.improve[locale], icon: 'arrows-clockwise' },
];
const pageTitle = `${project.title[locale]} — Yassir Drissi`;
const pageDescription = `${project.problem[locale]} ${project.result[locale]}`.slice(0, 300);
---

<Layout locale={locale} title={pageTitle} description={pageDescription} ogType="article">
  <Section tone="page" class="pb-10 pt-6 md:pt-10">
    <Container class="w-full max-w-5xl px-[clamp(1.25rem,4vw,2rem)]">
      <a href={`${getNovaLocalePath(locale)}#projets`} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold ui-text-on-light-subtle hover:text-brand-accent">
        <i class="ph ph-arrow-left" aria-hidden="true"></i>{t.back}
      </a>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="pf-chip">{categoryLabels[project.category][locale]}</span>
        <span class="text-sm ui-text-on-light-subtle"><T text={project.context[locale]} /></span>
        {project.year && <span class="text-sm ui-text-on-light-subtle">· <T text={project.year} /></span>}
      </div>
      <h1 class="m-0 mt-4 font-heading text-[clamp(2.25rem,6vw,3.75rem)] font-bold leading-[1] tracking-[-0.05em]">{project.title[locale]}</h1>
      <p class="m-0 mt-5 max-w-3xl text-[clamp(1.05rem,1.6vw,1.25rem)] leading-relaxed ui-text-on-light-subtle"><T text={project.problem[locale]} /></p>

      <div class="mt-6 flex flex-wrap gap-3">
        {project.links?.code && (
          <a href={project.links.code} target="_blank" rel="noopener noreferrer" class="ui-button ui-button-primary min-h-11 rounded-full px-5 py-2.5 text-sm font-semibold">
            <i class="ph ph-github-logo text-lg" aria-hidden="true"></i>{t.viewCode}
          </a>
        )}
        {project.links?.demo && (
          <a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="ui-button ui-button-outline min-h-11 rounded-full px-5 py-2.5 text-sm font-semibold">
            <i class="ph ph-arrow-square-out text-lg" aria-hidden="true"></i>{t.viewDemo}
          </a>
        )}
        {project.links?.post && (
          <a href={project.links.post} target="_blank" rel="noopener noreferrer" class="ui-button ui-button-outline min-h-11 rounded-full px-5 py-2.5 text-sm font-semibold">
            <i class="ph ph-linkedin-logo text-lg" aria-hidden="true"></i>{t.viewPost}
          </a>
        )}
        {!project.links?.code && (
          <span class="inline-flex items-center gap-2 text-sm ui-text-on-light-subtle"><i class="ph ph-lock-simple" aria-hidden="true"></i>{t.noPublicCode}</span>
        )}
      </div>

      {project.metrics && project.metrics.length > 0 && (
        <section aria-label={t.keyFigures} class="pf-metrics mt-10">
          {project.metrics.map((metric) => (
            <div class="pf-metric">
              <strong>{metric.value}</strong>
              <span>{metric.label[locale]}</span>
            </div>
          ))}
        </section>
      )}

      {images.length > 0 && (
        <section aria-label={t.gallery} class="mt-10" data-lightbox-group>
          <figure class="m-0">
            <button type="button" class="pf-shot pf-shot--main" data-lightbox data-href={images[0].full} data-title={images[0].alt[locale]}>
              <img src={images[0].src} alt={images[0].alt[locale]} width={images[0].width} height={images[0].height} loading="eager" decoding="async" />
            </button>
            {images[0].caption && <figcaption class="mt-2 text-sm ui-text-on-light-subtle">{images[0].caption[locale]}</figcaption>}
          </figure>
          {images.length > 1 && (
            <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3">
              {images.slice(1).map((image) => (
                <button type="button" class="pf-shot" data-lightbox data-href={image.full} data-title={image.alt[locale]}>
                  <img src={image.src} alt={image.alt[locale]} width={image.width} height={image.height} loading="lazy" decoding="async" style={image.position ? `object-position: ${image.position}` : undefined} />
                </button>
              ))}
            </div>
          )}
        </section>
      )}

      <div class="mt-12 grid gap-10 md:grid-cols-[minmax(0,1fr)_16rem] md:gap-12">
        <article class="grid gap-10">
          <section aria-labelledby="probleme">
            <h2 id="probleme" class="pf-detail-title"><i class="ph ph-target" aria-hidden="true"></i>{t.problem}</h2>
            <p class="m-0 mt-3 leading-relaxed"><T text={project.details.problem[locale]} /></p>
          </section>
          {sections.map((section) => (
            <section aria-labelledby={section.id}>
              <h2 id={section.id} class="pf-detail-title"><i class={`ph ph-${section.icon}`} aria-hidden="true"></i>{section.title}</h2>
              <ul class="pf-detail-list">
                {section.items.map((item) => <li><T text={item} /></li>)}
              </ul>
            </section>
          ))}
        </article>

        <aside class="md:sticky md:top-28 md:self-start">
          <h2 class="m-0 text-xs font-bold uppercase tracking-[0.14em] ui-text-on-light-subtle">{t.stack}</h2>
          <ul class="m-0 mt-3 flex list-none flex-wrap gap-1.5 p-0" role="list">
            {project.stack.map((tech) => <li class="pf-chip">{tech}</li>)}
          </ul>
          <h2 class="m-0 mt-8 text-xs font-bold uppercase tracking-[0.14em] ui-text-on-light-subtle">{ui.projects.did}</h2>
          <p class="m-0 mt-2 text-[0.92rem] leading-relaxed"><T text={project.did[locale]} /></p>
        </aside>
      </div>

      <nav class="mt-16 grid gap-4 border-t border-[var(--color-outline-variant)] pt-8 sm:grid-cols-2" aria-label={ui.projects.title}>
        <a href={localizePath(`/projets/${previous.slug}/`, locale)} class="pf-pager">
          <span class="text-xs font-semibold uppercase tracking-[0.12em] ui-text-on-light-subtle">← {t.previous}</span>
          <span class="font-heading text-lg font-bold">{previous.title[locale]}</span>
        </a>
        <a href={localizePath(`/projets/${next.slug}/`, locale)} class="pf-pager sm:text-right">
          <span class="text-xs font-semibold uppercase tracking-[0.12em] ui-text-on-light-subtle">{t.next} →</span>
          <span class="font-heading text-lg font-bold">{next.title[locale]}</span>
        </a>
      </nav>
    </Container>
  </Section>
</Layout>

<style>
  .pf-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1px;
    overflow: hidden;
    border-radius: var(--ui-radius-lg);
    background: var(--pf-ink-border);
  }

  .pf-metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    background: var(--pf-ink);
    color: var(--pf-ink-text);
  }

  .pf-metric strong {
    color: var(--pf-ink-accent);
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .pf-metric span {
    color: var(--pf-ink-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .pf-shot {
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-md);
    padding: 0;
    background: var(--color-surface-container-low);
    cursor: zoom-in;
  }

  .pf-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .pf-shot:not(.pf-shot--main) img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .pf-detail-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pf-detail-title i {
    color: var(--color-brand-accent);
  }

  .pf-detail-list {
    display: grid;
    gap: 0.6rem;
    margin: 0.85rem 0 0;
    padding-left: 1.2rem;
    line-height: 1.6;
  }

  .pf-detail-list li::marker {
    color: var(--color-brand-accent);
  }

  .pf-pager {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-md);
    padding: 1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .pf-pager:hover {
    border-color: var(--color-brand-accent);
  }
</style>
