---
// Deux projets phares en grand format (structure du ProjectsBlock Nova).
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import T from './T.astro';
import { featuredProjects } from '@data/portfolio/projects';
import { getNovaCopy, getNovaLocalePath, localizePath, type NovaLocale } from '@utils/nova-i18n';
import { resolveProjectImage } from '@utils/portfolio-images';

interface Props {
  locale: NovaLocale;
}

const { locale } = Astro.props;
const ui = getNovaCopy(locale);
const covers = await Promise.all(featuredProjects.map((p) => (p.images?.[0] ? resolveProjectImage(p.images[0]) : null)));
---

<Section id="realisations" tone="page" class="relative z-[1] pb-16 pt-16 md:pt-20">
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="grid gap-5 md:grid-cols-2 md:items-end md:gap-11" data-motion-sequence="viewport" data-motion-profile="soft">
      <Heading tag="h2" variant="section-title" class="max-w-[37rem]">{ui.featured.title}</Heading>
      <div class="flex flex-col items-start gap-3 md:items-end md:text-right">
        <Text variant="lead">{ui.featured.description}</Text>
        <a class="group inline-flex min-h-11 items-center gap-1.5 font-medium hover:text-brand-accent" href={`${getNovaLocalePath(locale)}#projets`}>
          {ui.featured.linkLabel}
          <span class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {featuredProjects.map((project, index) => {
        const href = localizePath(`/projets/${project.slug}/`, locale);
        const cover = covers[index];
        const coverInput = project.images?.[0];
        return (
          <article class:list={['pf-feature group', index === 0 ? 'pf-feature--vision' : 'pf-feature--data']} data-motion="viewport">
            <a href={href} class="pf-feature__link">
              <div class="pf-feature__visual">
                {cover ? (
                  <img src={cover.src} alt={coverInput?.alt[locale] ?? ''} width={cover.width} height={cover.height} loading="lazy" decoding="async" style={coverInput?.position ? `object-position: ${coverInput.position}` : undefined} />
                ) : (
                  <div class="pf-feature__metrics" aria-hidden="true">
                    {project.metrics?.slice(0, 2).map((m) => (
                      <div>
                        <strong>{m.value}</strong>
                        <span>{m.label[locale]}</span>
                      </div>
                    ))}
                  </div>
                )}
              </div>
              <div class="pf-feature__overlay">
                <div class="min-w-0">
                  <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--pf-ink-accent)]"><T text={project.context[locale]} /></p>
                  <h3 class="m-0 mt-2 font-heading text-[clamp(1.5rem,2.6vw,2.1rem)] font-bold tracking-[-0.03em]">{project.title[locale]}</h3>
                  <p class="m-0 mt-2 max-w-xl text-[0.95rem] leading-relaxed text-[var(--pf-ink-muted)]">{project.result[locale]}</p>
                </div>
                <span class="pf-feature__arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </Container>
</Section>

<style>
  .pf-feature {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--ui-radius-lg);
    background: var(--pf-ink);
    color: var(--pf-ink-text);
    box-shadow: var(--ui-elevation-strong);
  }

  .pf-feature__link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .pf-feature__visual {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .pf-feature__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pf-feature:hover .pf-feature__visual img {
    transform: scale(1.03);
  }

  .pf-feature__metrics {
    display: grid;
    height: 100%;
    grid-template-columns: 1fr 1fr;
    align-content: center;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background:
      radial-gradient(circle at 85% 15%, rgb(37 99 235 / 0.55), transparent 55%),
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 36px 36px,
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 36px 36px;
  }

  .pf-feature__metrics strong {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pf-feature__metrics span {
    display: block;
    margin-top: 0.5rem;
    color: var(--pf-ink-muted);
    font-size: 0.9rem;
  }

  .pf-feature__overlay {
    display: flex;
    flex: 1;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid var(--pf-ink-border);
  }

  .pf-feature__arrow {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    place-items: center;
    border-radius: 9999px;
    background: var(--color-brand-accent);
    color: var(--pf-on-accent);
    font-size: 1.1rem;
    transition: transform 300ms ease;
  }

  .pf-feature:hover .pf-feature__arrow {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-feature__visual img,
    .pf-feature__arrow {
      transition: none;
    }
  }
</style>
