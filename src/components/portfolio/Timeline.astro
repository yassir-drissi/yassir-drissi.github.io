---
// Parcours : frise des expériences et de la formation, puis certifications.
import Section from '@components/ui/layout/Section.astro';
import Container from '@components/ui/layout/Container.astro';
import Heading from '@components/ui/atoms/Heading.astro';
import Text from '@components/ui/atoms/Text.astro';
import T from './T.astro';
import { experiences } from '@data/portfolio/experience';
import { education, certifications, complementaryTraining } from '@data/portfolio/education';
import { getNovaCopy, localizePath, type NovaLocale } from '@utils/nova-i18n';

interface Props {
  locale: NovaLocale;
}

const { locale } = Astro.props;
const ui = getNovaCopy(locale).timeline;

type Entry =
  | { kind: 'experience'; start: string; item: (typeof experiences)[number] }
  | { kind: 'education'; start: string; item: (typeof education)[number] };

const entries: Entry[] = [
  ...experiences.map((item) => ({ kind: 'experience' as const, start: item.start, item })),
  ...education.map((item) => ({ kind: 'education' as const, start: item.start, item })),
].sort((a, b) => b.start.localeCompare(a.start));
---

<Section id="parcours" tone="page" class="py-[clamp(4rem,7vw,6.5rem)]">
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div data-motion-sequence="viewport" data-motion-profile="soft">
      <Heading tag="h2" variant="section-title">{ui.title}</Heading>
      <Text variant="lead" class="mt-3 max-w-xl">{ui.description}</Text>
    </div>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-16">
      <ol class="pf-timeline" role="list">
        {entries.map((entry) => (
          <li class="pf-timeline__item" data-motion="viewport">
            <span class:list={['pf-timeline__dot', entry.kind === 'education' && 'is-education']} aria-hidden="true">
              <i class:list={['ph', entry.kind === 'experience' ? 'ph-briefcase' : 'ph-graduation-cap']}></i>
            </span>
            <div class="pf-timeline__card">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                <span class="pf-chip">{entry.kind === 'experience' ? ui.experience : ui.education}</span>
                <span class="font-medium ui-text-on-light-subtle">{entry.item.period[locale]}</span>
              </div>
              {entry.kind === 'experience' ? (
                <>
                  <h3 class="m-0 mt-3 font-heading text-lg font-bold tracking-[-0.015em]">{entry.item.role[locale]}</h3>
                  <p class="m-0 mt-1 font-medium">
                    {entry.item.company}
                    <span class="font-normal ui-text-on-light-subtle"> · <T text={entry.item.location[locale]} /></span>
                  </p>
                  <p class="m-0 mt-3 text-[0.95rem] leading-relaxed ui-text-on-light-subtle">{entry.item.summary[locale]}</p>
                  {entry.item.highlights[locale].length > 0 && (
                    <ul class="pf-timeline__list">
                      {entry.item.highlights[locale].map((h) => <li>{h}</li>)}
                    </ul>
                  )}
                  <div class="mt-3 flex flex-wrap items-center gap-1.5">
                    {entry.item.stack.map((tech) => <span class="pf-tag">{tech}</span>)}
                  </div>
                  {entry.item.project && (
                    <a href={localizePath(`/projets/${entry.item.project}/`, locale)} class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-brand-accent hover:underline">
                      {ui.seeProject} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </>
              ) : (
                <>
                  <h3 class="m-0 mt-3 font-heading text-lg font-bold tracking-[-0.015em]">{entry.item.degree[locale]}</h3>
                  <p class="m-0 mt-1 font-medium">{entry.item.school}</p>
                  {entry.item.details && <p class="m-0 mt-3 text-[0.95rem] ui-text-on-light-subtle">{entry.item.details[locale]}</p>}
                </>
              )}
            </div>
          </li>
        ))}
      </ol>

      <div>
        <h3 class="m-0 font-heading text-xl font-bold">{ui.certifications}</h3>
        <ul class="m-0 mt-5 grid list-none gap-3 p-0" role="list">
          {certifications.map((cert) => (
            <li class="pf-cert" data-motion="viewport">
              <span class:list={['pf-cert__icon', !cert.obtained && 'is-pending']} aria-hidden="true">
                <i class:list={['ph', cert.obtained ? 'ph-seal-check' : 'ph-hourglass-medium']}></i>
              </span>
              <div class="min-w-0">
                <p class="m-0 font-semibold leading-snug">
                  {cert.url ? <a href={cert.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-accent"><T text={cert.name} /></a> : <T text={cert.name} />}
                </p>
                <p class="m-0 mt-0.5 text-sm ui-text-on-light-subtle">
                  {cert.issuer}{cert.year ? ` · ${cert.year}` : ''} · {cert.obtained ? ui.obtained : ui.inProgress}
                </p>
                {cert.post && (
                  <a href={cert.post} target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex min-h-8 items-center gap-1 text-sm font-semibold text-brand-accent hover:underline">
                    <i class="ph ph-linkedin-logo" aria-hidden="true"></i>{ui.viewPost}<span class="sr-only"> : {cert.name}</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>

        {complementaryTraining.length > 0 && (
          <>
            <h3 class="m-0 mt-10 font-heading text-xl font-bold">{ui.complementary}</h3>
            <ul class="m-0 mt-5 grid list-none gap-3 p-0" role="list">
              {complementaryTraining.map((course) => (
                <li class="pf-cert" data-motion="viewport">
                  <span class="pf-cert__icon" aria-hidden="true"><i class="ph ph-book-open-text"></i></span>
                  <div class="min-w-0">
                    <p class="m-0 font-semibold leading-snug">{course.name}</p>
                    <p class="m-0 mt-0.5 text-sm ui-text-on-light-subtle">{course.issuer} · {course.year}</p>
                    {course.post && (
                      <a href={course.post} target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex min-h-8 items-center gap-1 text-sm font-semibold text-brand-accent hover:underline">
                        <i class="ph ph-linkedin-logo" aria-hidden="true"></i>{ui.viewPost}<span class="sr-only"> : {course.name}</span>
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>
  </Container>
</Section>

<style>
  .pf-timeline {
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0 0 0 2.75rem;
    list-style: none;
  }

  .pf-timeline::before {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 1.05rem;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-brand-accent), var(--color-outline-variant));
    content: '';
  }

  .pf-timeline__item {
    position: relative;
  }

  .pf-timeline__dot {
    position: absolute;
    top: 1.1rem;
    left: -2.75rem;
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 2px solid var(--color-brand-accent);
    border-radius: 9999px;
    background: var(--ui-bg-page);
    color: var(--color-brand-accent);
    font-size: 1rem;
  }

  .pf-timeline__dot.is-education {
    border-color: var(--color-outline);
    color: var(--color-on-surface-variant);
  }

  .pf-timeline__card {
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-lg);
    padding: 1.25rem;
    background: var(--color-surface);
    box-shadow: var(--ui-elevation-soft);
  }

  .pf-timeline__list {
    display: grid;
    gap: 0.4rem;
    margin: 0.85rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .pf-timeline__list li::marker {
    color: var(--color-brand-accent);
  }

  .pf-tag {
    border: 1px solid var(--color-outline-variant);
    border-radius: 0.4rem;
    padding: 0.15rem 0.5rem;
    color: var(--color-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .pf-cert {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--ui-radius-md);
    padding: 0.9rem 1rem;
    background: var(--color-surface);
  }

  .pf-cert__icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    border-radius: 9999px;
    background: var(--pf-chip-bg);
    color: var(--pf-chip-text);
    font-size: 1.15rem;
  }

  .pf-cert__icon.is-pending {
    background: var(--color-surface-container-low);
    color: var(--color-on-surface-variant);
  }
</style>
