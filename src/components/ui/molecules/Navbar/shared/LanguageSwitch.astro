---
// Sélecteur FR / EN : renvoie vers la page équivalente dans l'autre langue
// (ex. /projets/hayati/ <-> /en/projects/hayati/).
import { getNovaCopy, translatePath, type NovaLocale } from '@utils/nova-i18n';

interface Props {
  locale?: NovaLocale;
}

const { locale = 'fr' } = Astro.props as Props;
const copy = getNovaCopy(locale).navigation;
// Sur la page 404 (qui n'existe qu'à la racine), le sélecteur renvoie vers l'accueil de chaque langue.
const pathname = /^\/404(\.html|\/)?$/.test(Astro.url.pathname) ? '/' : Astro.url.pathname;
const options: Array<{ code: NovaLocale; label: string; lang: string }> = [
  { code: 'fr', label: 'FR', lang: 'fr' },
  { code: 'en', label: 'EN', lang: 'en' },
];
---

<nav class="nova-language-switch" aria-label={copy.languageLabel}>
  {options.map((option, index) => (
    <>
      {index > 0 && <span class="nova-language-switch__separator" aria-hidden="true">/</span>}
      <a
        href={translatePath(pathname, option.code)}
        hreflang={option.lang}
        lang={option.lang}
        class:list={['nova-language-switch__link', locale === option.code && 'is-active']}
        aria-current={locale === option.code ? 'page' : undefined}
      >{option.label}</a>
    </>
  ))}
</nav>

<style>
  .nova-language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .nova-language-switch__link {
    border-radius: 0.25rem;
    padding: 0.5rem 0.25rem;
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
    transition: opacity 180ms ease, color 180ms ease;
  }

  .nova-language-switch__link:hover,
  .nova-language-switch__link:focus-visible,
  .nova-language-switch__link.is-active {
    color: var(--color-brand-accent);
    opacity: 1;
  }

  .nova-language-switch__separator {
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .nova-language-switch__link {
      transition: none;
    }
  }
</style>
