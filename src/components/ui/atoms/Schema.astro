---
// Données structurées JSON-LD : une personne (Person) et le site (WebSite).
import { profile } from '@data/portfolio/profile';
import { education } from '@data/portfolio/education';
import { SITE_URL } from '../../../../site.config.mjs';
import type { Locale } from '@data/portfolio/types';

interface Props {
	locale?: Locale;
	description?: string;
}

const { locale = 'fr', description = '' } = Astro.props;

// JSON.stringify n'échappe pas '<' : on le neutralise pour éviter toute injection via set:html.
const jsonLd = (data: object): string => JSON.stringify(data).replace(/</g, '\\u003c');
const siteBase = SITE_URL.replace(/\/$/, '');

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.title[locale],
	description,
	url: `${siteBase}/`,
	image: `${siteBase}${profile.photo}`,
	email: `mailto:${profile.email}`,
	address: { '@type': 'PostalAddress', addressLocality: 'Rabat', addressCountry: 'MA' },
	alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
	sameAs: [profile.links.linkedin, profile.links.github],
	knowsLanguage: ['ar', 'fr', 'en'],
};

const website = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: `${profile.name} — Portfolio`,
	url: `${siteBase}/`,
	inLanguage: locale,
};
---

<script type="application/ld+json" set:html={jsonLd(person)} />
<script type="application/ld+json" set:html={jsonLd(website)} />
